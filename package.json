{
  "name": "substition",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/prepare-assets.mjs && next build --webpack && node scripts/build-sw.mjs",
    "start": "next start --hostname 0.0.0.0",
    "lint": "oxlint --deny-warnings src tests scripts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.86",
    "@phosphor-icons/react": "^2.1.10",
    "better-auth": "^1.3.0",
    "next": "^16.0.0",
    "pdfjs-dist": "^5.4.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-icons": "^16.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.50.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@11.25.0"
}

{
  "id": "/",
  "name": "Substition — subscription clarity",
  "short_name": "Substition",
  "description": "A private home for your subscriptions.",
  "lang": "en",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#101512",
  "theme_color": "#101512",
  "categories": [
    "finance",
    "productivity"
  ],
  "icons": [
    {
      "src": "/brand/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/brand/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/brand/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add subscription",
      "url": "/?action=add",
      "icons": [
        {
          "src": "/brand/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Upcoming renewals",
      "url": "/?view=calendar"
    }
  ]
}